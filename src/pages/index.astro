---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../content/site';
import { withBase } from '../lib/url';

// Inline SVG markup (thin outline / stroke icons) keyed by ContactLink.icon.
const iconSvg: Record<string, string> = {
  email:
    '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
  github:
    '<path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/>',
  linkedin:
    '<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/>',
};
---

<BaseLayout>
  {/* Blog link hidden for now — uncomment to show it in the menu again.
  <nav class="topnav">
    <a href={withBase('/blog')}>Blog</a>
  </nav>
  */}

  <header>
    <div class="photo">
      <!-- swap for a real photo: set `photoSrc` in src/content/site.ts -->
      {site.photoSrc && <img src={site.photoSrc} alt={site.photoAlt} />}
    </div>
    <h1>{site.name}</h1>
  </header>

  {site.intro.map((paragraph) => (
    <p set:html={paragraph} />
  ))}

  <p class="muted" set:html={site.introMuted} />

  <p set:html={site.introClosing} />

  <hr />

  <h2>Some things I've built</h2>

  {site.projects.map((project) => (
    <div class="work-line">
      {project.wip && <span class="wip-tag">WIP</span>}{project.url ? <a href={project.url} target="_blank">{project.name}</a> : project.name} — {project.description}
      <div class="stack">{project.stack}</div>
    </div>
  ))}

  <hr />

  <h2>Where I've worked</h2>

  {site.workHistory.map((role) => (
    <div class="role-line">
      {role.title}, {role.company} <span class="when">— {role.when}</span>
      {role.description && <div class="role-desc">{role.description}</div>}
    </div>
  ))}
  <p style="margin-top:16px;"><a href={withBase(site.resumeHref)} download>Full résumé (PDF)</a></p>

  <hr />

  <div class="contact">
    {site.contactLinks.map((link) => {
      const isMail = link.href.startsWith('mailto:');
      const svg = link.icon ? iconSvg[link.icon] : undefined;
      return (
        <a
          href={link.href}
          aria-label={link.label}
          target={isMail ? undefined : '_blank'}
          rel={isMail ? undefined : 'noopener'}
        >
          {svg ? (
            <svg
              viewBox="0 0 24 24"
              width="20"
              height="20"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <Fragment set:html={svg} />
            </svg>
          ) : (
            link.label
          )}
        </a>
      );
    })}
  </div>
</BaseLayout>

<style>
  header {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-bottom: 40px;
  }
  .photo {
    flex: 0 0 auto;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    background: var(--line);
    overflow: hidden;
  }
  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .work-line,
  .role-line {
    margin-bottom: 14px;
  }
  .role-line {
    margin-bottom: 20px;
  }
  .role-desc {
    margin-top: 4px;
    color: var(--muted);
    font-size: 0.8em;
  }
  .wip-tag {
    display: inline-block;
    margin-right: 8px;
    padding: 0 5px;
    border: 1px solid var(--line);
    border-radius: 3px;
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--accent);
    vertical-align: 1px;
  }
  .work-line .stack,
  .role-line .when {
    color: var(--muted);
    font-size: 0.75em;
  }

  .contact {
    display: flex;
    justify-content: center;
    gap: 24px;
  }
  .contact a {
    display: inline-flex;
    color: var(--muted);
    text-decoration: none;
  }
  .contact a:hover {
    color: var(--accent);
  }
  .contact svg {
    display: block;
  }
</style>
